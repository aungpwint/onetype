{
    "name": "onetype",
    "private": true,
    "version": "1.4.0",
    "type": "module",
    "description": "Offline-first English and Myanmar typing tutor for students and classrooms.",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.node.json",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "validate:lessons": "vitest run tests/data/curriculum.test.ts",
        "checksums": "node scripts/generate-checksums.mjs --dir dist/updates",
        "checksums:verify": "node scripts/generate-checksums.mjs --verify --dir dist/updates",
        "validate:release": "node scripts/validate-release.mjs --dir dist/updates",
        "release": "node scripts/release.mjs"
    },
    "dependencies": {
        "@radix-ui/react-progress": "^1.1.16",
        "@radix-ui/react-switch": "^1.3.7",
        "@radix-ui/react-tabs": "^1.1.21",
        "@radix-ui/react-tooltip": "^1.2.16",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/api": "^2",
        "@tauri-apps/plugin-dialog": "^2.7.3",
        "@tauri-apps/plugin-notification": "^2.4.0",
        "@tauri-apps/plugin-process": "^2.3.1",
        "@tauri-apps/plugin-updater": "^2.11.0",
        "clsx": "^2.1.1",
        "framer-motion": "^13.2.0",
        "lucide-react": "^1.45.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router-dom": "^7.18.3",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "zod": "^4.6.2",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tauri-apps/cli": "^2",
        "@types/node": "^26.5.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.10.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.6",
        "globals": "^17.12.0",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.0"
    }
}
